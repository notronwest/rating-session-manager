<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchDaemon (ROOT): run camd on the mini in TCP-ingest mode for the BASELINE camera.
     Consumes the Pi 5 feed (tcp://10.0.0.120:8555, the Court4Cam Pi), streams to YouTube, records to the
     NAS on demand, relays the CV leg — replacing hand-run OBS + court-vision/fanout.sh.
     KeepAlive restarts it if it dies; the daemon self-heals the pipeline internally too.

     MUST be a root LaunchDaemon, NOT a user LaunchAgent: macOS 15 (Sequoia) Local Network Privacy
     blocks a user-agent's ffmpeg from reaching the Pi's LAN IP (every connect fails "No route to
     host" while the shell, which holds the grant, reaches it fine). A root system daemon is not
     subject to that user-space gate, so it just works — and a boot-time daemon is the right shape
     for an always-on streamer (starts before login, survives logout).

     Install (owned by root):
       sudo mkdir -p /opt/wmpc/pi-capture && sudo cp -R . /opt/wmpc/pi-capture/pi-capture-src
       sudo cp com.wmpc.camd.plist /Library/LaunchDaemons/
       sudo launchctl load /Library/LaunchDaemons/com.wmpc.camd.plist
     Verify: curl -s localhost:8080/status | jq -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wmpc.camd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/opt/wmpc/pi-capture/pi-capture-src/camd.py</string>
    <string>--config</string>
    <string>/opt/wmpc/pi-capture/mini/camera.baseline.conf</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- ffmpeg from Homebrew; adjust if installed elsewhere -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/wmpc-camd.err</string>
  <key>StandardOutPath</key><string>/tmp/wmpc-camd.out</string>
</dict>
</plist>
