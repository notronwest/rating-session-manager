<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent: remount the NAS at login and every 5 min (self-heals after a NAS/network blip).
     Install (as the mini user):
       cp com.wmpc.nas-mount.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.wmpc.nas-mount.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wmpc.nas-mount</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/opt/wmpc/pi-capture/mini/mount-nas.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardErrorPath</key><string>/tmp/wmpc-nas-mount.err</string>
  <key>StandardOutPath</key><string>/tmp/wmpc-nas-mount.out</string>
</dict>
</plist>
