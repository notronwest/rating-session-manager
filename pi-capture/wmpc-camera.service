# WMPC court-camera capture daemon (Track 1). Install on the Raspberry Pi:
#   sudo cp wmpc-camera.service /etc/systemd/system/
#   sudo systemctl enable --now wmpc-camera
[Unit]
Description=WMPC court-camera capture daemon (camd)
After=network-online.target mnt-wmpc\x2dvideo.mount
Wants=network-online.target

[Service]
Type=simple
# Config lives at /etc/wmpc/camera.conf (see camera.conf.example).
Environment=CAMD_CONFIG=/etc/wmpc/camera.conf
ExecStart=/usr/bin/python3 /opt/wmpc/pi-capture/camd.py
Restart=always
RestartSec=5
# rpicam-vid needs the video group; the camera user must be in it.
User=wmpc
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
