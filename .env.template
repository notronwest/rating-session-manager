# CourtReserve — schedule sync goes through the shared courtreserve-api HTTP
# service (which owns the CR login + browser and runs on the club Mac mini).
# Point these at that service; no CR password is needed on this side.
#   CRAPI_URL — service base, e.g. http://localhost:8787 on the mini itself,
#               or http://<mac-mini-lan-ip>:8787 from another host.
#   CRAPI_KEY — shared secret, sent as the X-API-Key header (== the service's
#               CRAPI_KEY). See ../courtreserve-api/deploy/README.md.
CRAPI_URL=http://localhost:8787
CRAPI_KEY=your-courtreserve-api-key

# CourtReserve credentials — only still used by the legacy Python scripts
# (scripts/scrape-members.py member sync, scripts/fetch-schedule.py). The app's
# schedule sync no longer needs them; leave blank if you only use courtreserve-api.
CR_EMAIL=your-email@example.com
CR_PASSWORD=your-password
CR_BASE_URL=https://app.courtreserve.com
# These are auto-derived but can be overridden:
# CR_LOGIN_URL=https://app.courtreserve.com/Account/Login
# CR_USERNAME=your-email@example.com

# Video processing
# Optional — defaults to <project_root>/videos if unset.
# Set to an absolute path if your recordings live elsewhere.
# VIDEO_DIR=/absolute/path/to/videos

# Server
PORT=3001

# Build output: dist goes to ../../www/$APP_NAME relative to web/
APP_NAME=sessionmanager

# Supabase — shared backend with wmpc_rating_hub
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ORG_SLUG=wmpc

# PB.vision Partner API — preferred path for uploading clips. Email
# support@pb.vision to request an API key for your partner account.
PBVISION_API_KEY=your-partner-api-key
# Optional: set to "1" to use pb.vision's test server instead of prod
# (sandbox; does not burn real credits). Defaults to prod.
# PBVISION_USE_TEST_SERVER=1

# PB.vision (legacy, browser-automation upload — kept as a fallback while
# we migrate to the Partner API. Not required if PBVISION_API_KEY is set.)
PB_VISION_EMAIL=your-email@example.com
PB_VISION_PASSWORD=your-password

# Rating Hub webhook — receives video IDs after each pb.vision upload so the
# rating-hub downloads insights and populates its DB. URL and secret come
# from the wmpc_rating_hub Supabase project (Edge Functions → pbvision-webhook).
RATING_HUB_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/pbvision-webhook
RATING_HUB_WEBHOOK_SECRET=your-webhook-secret

# Base URL of the deployed rating-hub web app (used to deep-link back from
# session-manager after pushing a session to rating-hub).
RATING_HUB_BASE_URL=https://ratinghub.example.com

# Discord — operator alerts (e.g. CourtReserve sync failure).
# Each Discord webhook URL is channel-specific. Create one in Discord at
#   Server / channel → Integrations → Webhooks → New Webhook → Copy URL
# and paste it here. To send alerts to a separate channel from the
# sibling courtreserve-scheduler app, just use a different URL.
# Leave blank to disable alerting; failures still surface in the UI.
DISCORD_WEBHOOK_URL=

# Cloudflare Access — REQUIRED once the app is published through the Cloudflare
# Tunnel (deploy/cloudflared/, https://session.wmpc.app). The app has no login
# of its own, so the server refuses any request that arrived via Cloudflare
# unless it carries a valid Access token. Fail closed: with these unset, tunnel
# traffic gets 403 while LAN / localhost access is unaffected.
#   CF_ACCESS_TEAM_DOMAIN — your Zero Trust team name, e.g. "wmpc" (for
#                           wmpc.cloudflareaccess.com); the full host also works.
#   CF_ACCESS_AUD         — the Access application's "Application Audience (AUD)
#                           Tag" (Zero Trust → Access → Applications → the app →
#                           Overview). A 64-hex string.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# CF_ACCESS_DISABLE=1   # local debugging only — never on the mini
# WEB_DIST=/abs/path    # optional: where Express finds the built SPA
#                       # (default ../www/$APP_NAME next to the repo, = vite outDir)
